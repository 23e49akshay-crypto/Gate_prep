# 🧠 TODAY'S FORMULA CARD

### Profit

[
\boxed{SP-CP}
]

### Loss

[
\boxed{CP-SP}
]

### Profit %

[
\boxed{\frac{Profit}{CP}\times100}
]

### Loss %

[
\boxed{\frac{Loss}{CP}\times100}
]

### Discount

[
\boxed{MP-SP}
]

### Discount %

[
\boxed{\frac{Discount}{MP}\times100}
]

### SP at profit (P%)

[
\boxed{CP(1+P/100)}
]

### SP at loss (L%)

[
\boxed{CP(1-L/100)}
]

### SP after discount (D%)

[
\boxed{MP(1-D/100)}
]

### Successive discounts

[
\boxed{a+b-\frac{ab}{100}}
]

### Markup + discount

[
\boxed{
SP=CP(1+M/100)(1-D/100)
}
]

